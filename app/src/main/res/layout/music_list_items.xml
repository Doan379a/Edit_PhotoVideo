<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="horizontal"
    android:background="@color/black"
    android:id="@+id/rootView"
    >

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/appCompatImageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/ic_music"
        android:layout_centerVertical="true"
        />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@+id/radioMusicName"
        android:layout_toEndOf="@+id/appCompatImageView"
        android:orientation="vertical"
        android:layout_centerVertical="true"
        android:layout_marginStart="15dp"
        >

        <TextView
            android:id="@+id/txt_music_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/polly_regular_400"
            android:textColor="@color/white"
            android:textSize="14sp"
            tools:text="dfghfffh" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_music_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/polly_regular_400"
                android:textColor="#919191"
                android:textSize="11sp"
                tools:text="dfghfffh" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:fontFamily="@font/polly_regular_400"
                android:text="."
                android:textColor="#919191"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txt_music_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/polly_regular_400"
                android:textColor="#919191"
                android:textSize="11sp"
                tools:text="dfghfffh" />
        </LinearLayout>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/radioMusicName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableRight="@drawable/bg_radio_checked"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:button="@null"
        android:clickable="true"
        android:focusable="true"
      />
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@+id/clickableView"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="75dp"
    android:layout_height="75dp"
    android:background="@drawable/bg_width_radius_green_unselected"
    android:layout_marginEnd="10dp"
    >

        <ImageView
        android:id="@+id/ivThumb"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:src="@drawable/jalousie_bt"
        android:layout_centerInParent="true"
        />

    <TextView
        android:id="@+id/tvThemeName"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_alignParentBottom="true"
        android:layout_gravity="center"
        android:layout_margin="1.5dp"
        android:layout_centerHorizontal="true"
        android:background="@drawable/bg_width_radius_bottom"
        android:gravity="center"
        android:maxLines="1"
        android:singleLine="true"
        android:paddingHorizontal="5dp"
        android:paddingBottom="2dp"
        android:fontFamily="@font/polly_regular_400"
        android:textColor="@color/color_selector_tab"
        android:textSize="10sp"
        android:visibility="visible"
        android:includeFontPadding="false"

        />
</RelativeLayout>

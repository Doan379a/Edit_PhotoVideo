<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="17sp"
        android:layout_marginVertical="10dp"
        android:background="@drawable/bg_dialog_result_spin_wheel"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="17sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:fontFamily="@font/polly_bold_700"
                android:gravity="center|center_vertical"
                android:includeFontPadding="false"
                android:paddingVertical="@dimen/_10sdp"
                android:text="@string/if_you_exit_the_project_will_be_disappeared_are_you_sure_that_you_want_to_exit"
                android:textColor="@color/black"
                android:textSize="@dimen/_14ssp" />

            <ImageView
                android:id="@+id/img_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/_10sdp"
                android:src="@drawable/ic_back"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="17sp"
                android:layout_marginVertical="15sp"
                android:layout_weight="1"
                android:background="@drawable/btn_done_button"
                android:fontFamily="@font/polly_bold_700"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingVertical="13sp"
                android:textColor="#E4E4E4"
                android:textSize="@dimen/_16ssp"
                android:text="@string/cancel" />

            <TextView
                android:id="@+id/tv_exit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="17sp"
                android:layout_marginVertical="15sp"
                android:layout_weight="1"
                android:background="@drawable/bg_exit"
                android:fontFamily="@font/polly_bold_700"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingVertical="13sp"
                android:textColor="@color/black"
                android:textSize="@dimen/_16ssp"
                android:text="@string/exit" />
        </LinearLayout>


    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
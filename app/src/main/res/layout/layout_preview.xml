<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:n3="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <RelativeLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="15dp"
            app:srcCompat="@drawable/ic_back" />

        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_gravity="left"
            android:layout_toEndOf="@+id/iv_back"
            android:fontFamily="@font/polly_bold_700"
            android:text="@string/edit_video"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/iv_done_preview"
            android:layout_width="80dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="15dp"
            android:background="@drawable/btn_done_button"
            android:fontFamily="@font/polly_bold_700"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/save"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </RelativeLayout>

    <com.example.editphotovideo.ui.editmovie.ScaleCardLayout
        android:id="@+id/scaleCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/linearLayout"
        android:layout_marginTop="15dp"
        android:orientation="vertical">

        <com.example.editphotovideo.ui.editmovie.PreviewImageView
            android:id="@+id/previewImageView1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="#ffffc0cb" />

        <ImageView
            android:id="@+id/ivFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignTop="@+id/previewImageView1"
            android:layout_alignBottom="@+id/previewImageView1" />


        <LinearLayout
            android:id="@+id/flLoader"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignTop="@+id/previewImageView1"
            android:layout_alignBottom="@+id/previewImageView1"
            android:layout_gravity="center"
            android:background="#88000000"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Applying Theme"
                android:textColor="?colorPrimary" />
        </LinearLayout>
    </com.example.editphotovideo.ui.editmovie.ScaleCardLayout>

    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/scaleCard"
        android:layout_gravity="bottom"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:visibility="visible">

        <RelativeLayout
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="15dp">

            <ImageView
                android:id="@+id/ivPlayPause"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_centerInParent="true"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_play_white" />

            <View
                android:id="@+id/video_clicker"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_card_transparent"
                android:clickable="true"
                android:focusable="true" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:fontFamily="@font/polly_regular_400"
            android:text="00:00"
            android:textColor="@color/color_9F9F9F"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/sbPlayTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:maxWidth="6dp"
            android:maxHeight="3dp"
            android:min="0"
            android:minWidth="2dp"
            android:minHeight="1dp"
            android:paddingVertical="8dp"
            android:progressDrawable="@drawable/custom_seekbar_progress2"
            android:thumb="@drawable/ic_thumb_seekbar2"
            android:thumbOffset="0dp" />

        <TextView
            android:id="@+id/tvEndTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="15dp"
            android:fontFamily="@font/polly_regular_400"
            android:text="00:00"
            android:textColor="@color/color_9F9F9F"
            android:textSize="12sp" />
    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/linearLayout2"
        android:layout_below="@+id/linearLayout3"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_alignParentBottom="true"
            android:background="@color/color_3F3F3F">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvThemes"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:layout_centerInParent="true"
                android:layout_gravity="center"
                android:layout_marginHorizontal="15dp"
                android:visibility="visible"
                />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFrame"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:layout_centerInParent="true"
                android:layout_gravity="center"
                android:layout_marginHorizontal="15dp"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/llmusic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="30dp"
                android:layout_centerInParent="true"
                android:visibility="gone"
                >
                <LinearLayout
                    android:id="@+id/iv_deviceMusic"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_weight="1"
                    android:background="@drawable/btn_done_button"
                    android:gravity="center"
                    android:layout_marginEnd="15dp"
                    >
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:srcCompat="@drawable/ic_device_music"
                        android:layout_marginEnd="7dp"
                        />
                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="@string/device_music"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:fontFamily="@font/polly_regular_400"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/iv_demoMusic"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_weight="1"
                    android:background="@drawable/btn_done_button"
                    android:gravity="center"
                    android:layout_marginEnd="15dp"
                    >
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:srcCompat="@drawable/ic_demo_music"
                        android:layout_marginEnd="7dp"
                        />
                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="@string/demo_music"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:fontFamily="@font/polly_regular_400"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>


    </RelativeLayout>

    <HorizontalScrollView
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:layout_marginStart="15dp"
        android:scrollbars="none"
        >


        <LinearLayout
            android:id="@+id/lleditArea"
            android:layout_width="fill_parent"
            android:layout_height="60dp"
            android:background="@color/black"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ibAddImages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:drawableTop="@drawable/ic_add_photo_editvideo"
                android:text="@string/add_photo"
                android:minWidth="65dp"
                android:gravity="center"
                android:layout_gravity="center"
                android:drawablePadding="7dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:fontFamily="@font/polly_regular_400"
                android:includeFontPadding="false"
                />
            <TextView
                android:id="@+id/ibAddTransition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:drawableTop="@drawable/ic_transition_selected_editvideo"
                android:text="@string/transition"
                android:minWidth="65dp"
                android:gravity="center"
                android:layout_gravity="center"
                android:drawablePadding="7dp"
                android:textColor="@color/color_selector_tab"
                android:textSize="11sp"
                android:fontFamily="@font/polly_regular_400"
                android:layout_marginStart="13dp"
                android:includeFontPadding="false"/>
            <TextView
                android:id="@+id/ibEditMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:drawableTop="@drawable/ic_add_photo_editvideo"
                android:text="@string/edit_photo"
                android:minWidth="65dp"
                android:gravity="center"
                android:layout_gravity="center"
                android:drawablePadding="7dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:fontFamily="@font/polly_regular_400"
                android:layout_marginStart="13dp"
                android:includeFontPadding="false"
                />

            <TextView
                android:id="@+id/ibAddMusic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:drawableTop="@drawable/ic_music_editvideo"
                android:text="@string/music"
                android:minWidth="65dp"
                android:gravity="center"
                android:layout_gravity="center"
                android:drawablePadding="7dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:fontFamily="@font/polly_regular_400"
                android:layout_marginStart="13dp"
                android:includeFontPadding="false"/>
            <TextView
                android:id="@+id/ibAddFrame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:drawableTop="@drawable/ic_frame_editvideo"
                android:text="@string/frame"
                android:minWidth="65dp"
                android:gravity="center"
                android:layout_gravity="center"
                android:drawablePadding="7dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:fontFamily="@font/polly_regular_400"
                android:layout_marginStart="13dp"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/ibAddDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:drawableTop="@drawable/ic_duration_editvideo"
                android:text="@string/duration"
                android:minWidth="65dp"
                android:gravity="center"
                android:layout_gravity="center"
                android:drawablePadding="7dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:fontFamily="@font/polly_regular_400"
                android:layout_marginStart="13dp"
                android:layout_marginEnd="13dp"
                android:includeFontPadding="false" />
        </LinearLayout>
    </HorizontalScrollView>


</RelativeLayout>